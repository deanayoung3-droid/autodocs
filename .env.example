# AutoDocs settings. `npm run setup` writes these for you; to do it by hand, copy this file:
#   to .env.local for local development (npm run dev), or
#   to .env for Docker (docker compose up).
# Restart the server after changing anything here.

# ─── Required ────────────────────────────────────────────────────────────────────────────────

# The setup password. Sign in at /login with it to create the owner account; afterwards it still
# works as a way back in if every owner is locked out. Use a long random value.
ADMIN_PASSWORD=

# Signs sign-in sessions and seals the credentials the app saves (GitHub, Slack, helpdesks...).
# Generate it once (openssl rand -hex 32) and never change it, or every integration needs
# connecting again.
SESSION_SECRET=

# The address people use to reach this server, with no trailing slash. Used in the widget snippet,
# the sitemap, emails, and webhooks. http://localhost:3000 for local development.
PUBLIC_URL=http://localhost:3000

# ─── AI ──────────────────────────────────────────────────────────────────────────────────────

# Everything AI (the docs agent, AI answers, AI search, verification, screenshots, translations)
# runs on the OpenAI API. Create a key at https://platform.openai.com/api-keys. The help center
# and editor work without one; the AI features stay off until it's set.
OPENAI_API_KEY=

# Optional model overrides. Settings → AI can also choose the agent and answer models.
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_ANSWER_MODEL=gpt-6.1-terra
# OPENAI_LIGHT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The most AI answers per day across all visitors, to cap spend if the site gets hammered.
# AI_DAILY_ASK_LIMIT=500

# ─── Database and files ──────────────────────────────────────────────────────────────────────

# PostgreSQL with the pgvector extension. When unset, a built-in Postgres (PGlite) runs inside the
# app and keeps its data in ./data/pg, which is right for trying it out and small teams on one
# server. docker-compose.yml sets this to its own Postgres container.
# DATABASE_URL=postgresql://user:password@host:5432/autodocs
# DB_POOL_SIZE=10

# Where the built-in database and uploaded files live when DATABASE_URL / GCS_BUCKET are unset.
# DATA_DIR=./data

# Screenshots and images go to a Google Cloud Storage bucket when this is set; otherwise to disk
# (DATA_DIR/files).
# GCS_BUCKET=

# ─── Optional ────────────────────────────────────────────────────────────────────────────────

# Give the admin its own address (e.g. https://admin.docs.example.com next to
# https://docs.example.com). Each address then serves only its own half; any other address still
# serves both.
# ADMIN_URL=

# Fill a new install from an existing help center on its first start (articles, sections, images,
# and redirects from the old addresses). You can also do this later in Settings → Import & export.
# SEED_IMPORT_URL=https://help.example.com

# Screenshots: a test account the agent signs in to your product with. You can also save it in the
# admin (Integrations → Dashboard). Login steps there refer to these as {{email}} and {{password}}.
# CAPTURE_EMAIL=
# CAPTURE_PASSWORD=
# CAPTURE_TIMEZONE=America/New_York

# Outgoing email (invitations, password resets, notifications, reader sign-in links). Easier to
# set in Settings → Email delivery; these are the fallback.
# SMTP_URL=smtp://user:password@smtp.yourprovider.com:587
# MAIL_FROM=Docs Agent <docs@yourcompany.com>

# Let readers sign in with their account on your product to see restricted docs. Your app signs an
# HS256 JWT ({sub|email, exp}) with this secret and redirects to /help/auth/jwt?token=…
# READER_JWT_SECRET=
# READER_SIGNIN_URL=https://app.example.com/login

# GitHub connects from Integrations → GitHub, which creates a GitHub App for this install; nothing
# to set here. Only for GitHub Enterprise Server: https://YOUR-HOST/api/v3
# GITHUB_API_URL=
# Without the GitHub App: a fine-grained read-only token and a webhook secret.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# Slack connects from Integrations → Slack. Fallbacks for the /docs command and channel posts:
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL=

# Background work runs inside the server. These tune it.
# AGENT_CONCURRENCY=2
# WORKER_DISABLED=1

# For testing integrations against stand-in APIs only.
# LINEAR_API_URL=
# HELPDESK_API_URL=
# HELPDESK_IMAP_HOST=
# HELPDESK_IMAP_PORT=
