# Where AutoDocs runs on Google Cloud. Copy to deploy/target.env, fill in the first block, and run
# deploy/gcp/setup.sh, which fills in the rest. No secrets go here: this file is committed, and the
# deploy workflow reads it. Secrets live in Secret Manager (see deploy/gcp/put-secret.sh).

# Fill these in.
GCP_PROJECT=
GCP_REGION=us-central1
ALERT_EMAILS=
MONTHLY_BUDGET_USD=200
PUBLIC_DOMAIN=docs.example.com
ADMIN_DOMAIN=admin.docs.example.com
# Optional: Google accounts allowed through Identity-Aware Proxy to the admin (deploy/gcp/iap.sh).
# IAP_USERS=you@yourcompany.com

# Sizes. These defaults fit a help center of a few hundred articles; change and rerun setup.sh only for a new
# install (an existing service keeps its size; change it with gcloud run services update).
# CPU=1
# MEMORY=2Gi
# MAX_INSTANCES=4
# DB_TIER=db-custom-1-3840

# Written by the scripts.
