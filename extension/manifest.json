{
  "manifest_version": 3,
  "name": "AutoDocs",
  "version": "1.0.0",
  "description": "Docs Agent in any tab: answer customers from your help center, search articles, draft replies with !!, and hand off docs tasks.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open Docs Agent", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["config.js", "content.js"], "run_at": "document_idle" }],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+F", "mac": "Alt+F" }, "description": "Open Docs Agent" }
  }
}
